- var combinedChartSettings = settings.shared_pages.page_header.network_charts.combined_chart
div#networkChartParent.col-lg-12(style='display:none;margin:10px 0;')
  .card.card-default.border-0
    .card-header
      strong Network Hashrate &amp; Difficulty
    .card-body
      canvas#networkChart(style='min-height:'+combinedChartSettings.chart_height+'px;max-height:'+combinedChartSettings.chart_height+'px;background-color:'+(combinedChartSettings.bgcolor == '' ? 'transparent' : combinedChartSettings.bgcolor)+';')
